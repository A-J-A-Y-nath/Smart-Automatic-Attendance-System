<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Attendance Code"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="Ask your teacher for the code currently shown on their screen. It changes every 15 seconds."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <!-- Code Input Box (Figma Screen 03) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/card_rotating_code"
        android:gravity="center">

        <EditText
            android:id="@+id/etDialogCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:hint="• • • •"
            android:inputType="number"
            android:maxLength="6"
            android:letterSpacing="0.4"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="⏱ 15s rotating dynamic code"
        android:textColor="@color/live_badge_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Dialog Actions (Figma Screen 03) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="CANCEL"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSubmit"
            style="@style/PrimaryActionButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="SUBMIT &amp; SCAN"
            android:textSize="12sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
